{
  "name": "trace",
  "productName": "Trace",
  "version": "0.3.5",
  "description": "Trace（笔迹）— 轻量级 Markdown 笔记",
  "main": "./out/main/index.js",
  "author": "Trace <trace@example.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "lint": "eslint src tests scripts",
    "icon": "node scripts/generate-icon.js",
    "dist:deb": "electron-vite build && electron-builder --linux deb",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@element-plus/icons-vue": "^2.3.2",
    "@octokit/rest": "^22.0.1",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "element-plus": "^2.14.5",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.6",
    "markdown-it": "^15.0.1",
    "markdown-it-texmath": "^1.0.0",
    "pinia": "^4.0.3",
    "simple-git": "^3.36.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "desktopName": "trace.desktop"
}
